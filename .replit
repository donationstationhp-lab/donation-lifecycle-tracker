modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
# DONATION_STATION_API_KEY must be set via the Replit Secrets pane, never committed here.
# The ATTEND Google Sheets sync and Notion health check are optional features.
# To enable them, set these via the Replit Secrets pane (never commit values here):
#   ATTEND_SHEETS_SPREADSHEET_ID, ATTEND_SHEETS_RANGE (Google Sheets connector via @replit/connectors-sdk)
#   NOTION_API_KEY, NOTION_ITEMS_DATA_SOURCE_URL, NOTION_ROUTES_DATA_SOURCE_URL
